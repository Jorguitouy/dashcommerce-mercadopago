{
  "name": "dashcommerce-mercadopago",
  "version": "0.1.1",
  "description": "Mercado Pago (Checkout Pro) payment provider for DashCommerce - the open-source commerce plugin for EmDash CMS. Covers all of Latin America plus USD/EUR.",
  "type": "module",
  "license": "MIT",
  "author": "Jorge Ferreira <jorgeferreirauy@gmail.com> (https://github.com/Jorguitouy)",
  "keywords": [
    "dashcommerce",
    "emdash",
    "mercadopago",
    "mercadolibre",
    "payments",
    "checkout",
    "payment-provider",
    "latam",
    "ecommerce",
    "astro",
    "typescript"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Jorguitouy/dashcommerce-mercadopago.git"
  },
  "bugs": {
    "url": "https://github.com/Jorguitouy/dashcommerce-mercadopago/issues"
  },
  "homepage": "https://github.com/Jorguitouy/dashcommerce-mercadopago#readme",
  "engines": {
    "node": ">=20"
  },
  "packageManager": "bun@1.3.14",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./entry": {
      "types": "./dist/entry.d.ts",
      "import": "./dist/entry.js"
    },
    "./payment-provider": {
      "types": "./dist/provider.d.ts",
      "import": "./dist/provider.js"
    },
    "./webhook": {
      "types": "./dist/webhook.d.ts",
      "import": "./dist/webhook.js"
    },
    "./routes": {
      "types": "./dist/routes.d.ts",
      "import": "./dist/routes.js"
    },
    "./money": {
      "types": "./dist/money.d.ts",
      "import": "./dist/money.js"
    },
    "./signature": {
      "types": "./dist/signature.d.ts",
      "import": "./dist/signature.js"
    },
    "./types": {
      "types": "./dist/types.d.ts",
      "import": "./dist/types.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md",
    "docs",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "bun test tests/",
    "test:watch": "bun test tests/ --watch",
    "typecheck": "tsc --noEmit",
    "prepublishOnly": "npm run build && npm run typecheck && npm test",
    "build": "tsc -p tsconfig.build.json"
  },
  "peerDependencies": {
    "@dashcommerce/core": "^0.3.0",
    "emdash": "^1.2.0"
  },
  "peerDependenciesMeta": {
    "@dashcommerce/core": {
      "optional": false
    },
    "emdash": {
      "optional": false
    }
  },
  "devDependencies": {
    "@dashcommerce/core": "0.3.0",
    "emdash": "1.2.0",
    "typescript": "^5.9.0"
  },
  "bin": {
    "dashcommerce-mercadopago-setup": "./scripts/setup.mjs"
  }
}
